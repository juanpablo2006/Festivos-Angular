<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Capa de Presentación: API REST (controladores, middleware y Swagger). Punto de entrada de la solución. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Genera el XML con los comentarios /// para que Swagger los muestre. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FestivosApi.Aplicacion\FestivosApi.Aplicacion.csproj" />
    <ProjectReference Include="..\FestivosApi.Infraestructura\FestivosApi.Infraestructura.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
